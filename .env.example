# ==============================================================================
# AI Language Village — Environment Variable Configuration Template
# ==============================================================================
#
# IMPORTANT SECURITY GUIDELINE:
# - Variables WITHOUT a "VITE_" prefix (like GROQ_API_KEY) are SERVER-ONLY.
#   They are accessible exclusively to backend serverless functions (/api/chat)
#   and will NEVER be bundled into client-side JavaScript.
# - Variables WITH a "VITE_" prefix are bundled into the client application.
#   Only place public configuration keys here.
#
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Server-Side AI Inference Secret
# Read exclusively by /api/chat serverless proxy
GROQ_API_KEY=your_groq_api_key_here

# Client-Side Firebase Configuration (Client-safe, protected by Firestore Security Rules)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

